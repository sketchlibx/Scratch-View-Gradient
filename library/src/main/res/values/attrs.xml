<resources>
    <declare-styleable name="AdvancedScratchView">
        <attr name="sv_cornerRadius" format="dimension" />
        <attr name="sv_borderWidth" format="dimension" />
        <attr name="sv_borderColor" format="color" />
        <attr name="sv_glassEffectEnabled" format="boolean" />
        <attr name="sv_metallicFoilEffect" format="boolean" />
        <attr name="sv_neonGlowEnabled" format="boolean" />
        
        <attr name="sv_brushSize" format="dimension" />
        <attr name="sv_scratchOpacity" format="float" />
        <attr name="sv_multiTouchEnabled" format="boolean" />
        
        <attr name="sv_revealThreshold" format="float" />
        <attr name="sv_autoRevealEnabled" format="boolean" />
        <attr name="sv_revealAnimationType" format="enum">
            <enum name="fade" value="0"/>
            <enum name="circular_expand" value="1"/>
            <enum name="explosion" value="2"/>
        </attr>
        <attr name="sv_revealDuration" format="integer" />
        <attr name="sv_particlesEnabled" format="boolean" />

        <attr name="sv_scratchText" format="string" />
        <attr name="sv_scratchTextSize" format="dimension" />
        <attr name="sv_scratchTextColor" format="color" />
        
        <attr name="sv_performanceMode" format="boolean" />
    </declare-styleable>
</resources>
